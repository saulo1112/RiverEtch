{
  "name": "@climate-change-ieee/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Solidity contracts (Hardhat 3) and circom circuits for the private ZK-compliance layer.",
  "type": "module",
  "scripts": {
    "zk:build": "tsx scripts/zk/build.ts",
    "compile": "hardhat compile",
    "test": "npm run test:circuits && npm run test:contracts",
    "test:circuits": "mocha",
    "test:contracts": "hardhat test",
    "lint:sol": "solhint --disc --noPoster --max-warnings 0 \"src/**/*.sol\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.0",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.1",
    "@types/snarkjs": "^0.7.9",
    "chai": "^6.3.0",
    "circom_tester": "^0.0.24",
    "circomlib": "^2.0.5",
    "ethers": "^6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "^3.18.1",
    "mocha": "^12.0.3",
    "snarkjs": "^0.7.6",
    "solhint": "^6.2.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
