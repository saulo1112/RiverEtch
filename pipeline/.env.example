# Copy to .env and fill in. Never commit the real file.

# Sentinel Hub API on the Copernicus Data Space Ecosystem (CDSE, free tier). Create an OAuth client at
# https://shapps.dataspace.copernicus.eu/dashboard/ (User settings > OAuth clients).
SH_CLIENT_ID=
SH_CLIENT_SECRET=
SH_BASE_URL=https://sh.dataspace.copernicus.eu
SH_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
