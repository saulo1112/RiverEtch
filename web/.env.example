# Copy to .env.local and fill in what you need. Every VITE_* variable is bundled into the public
# JavaScript: never put secrets here.

# WalletConnect Cloud project id (free at https://cloud.reown.com). Optional for local development:
# RainbowKit falls back to a shared demo id.
VITE_WALLETCONNECT_PROJECT_ID=

# Sepolia JSON-RPC endpoint (Alchemy, Infura, ...). Optional: defaults to a public, rate-limited RPC.
VITE_SEPOLIA_RPC_URL=
